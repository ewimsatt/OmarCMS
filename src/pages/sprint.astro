---
import BaseLayout from '../layouts/BaseLayout.astro';

const module = await import('../../sprint-board/tasks.json');
const rawTasks = module.default;
const tasksData = rawTasks.tasks;
const columnsList = rawTasks.columns;

const priorityOrder = {
  high: 3,
  medium: 2,
  low: 1
};

const priorityColors = {
  high: {
    bg: 'rgba(239, 68, 68, 0.15)',
    text: '#dc2626',
    accent: '#dc2626'
  },
  medium: {
    bg: 'rgba(245, 158, 11, 0.15)',
    text: '#d97706',
    accent: '#d97706'
  },
  low: {
    bg: 'rgba(16, 185, 129, 0.15)',
    text: '#059669',
    accent: '#059669'
  }
};

const groupedTasks = {};
for (const col of columnsList) {
  groupedTasks[col] = tasksData.filter(task => task.column === col);
}
---

<BaseLayout title="Sprint Board" description="OmarCMS maintenance sprint board">
  <main role="main" style="max-width: 1400px; margin: 0 auto; padding: 2rem 1rem;">
    <h1 style="font-size: 2.5rem; font-weight: bold; margin-bottom: 2rem; text-align: center; color: var(--text);">OmarCMS Sprint Board</h1>
    
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem;">
      {columnsList.map((col) => {
        const sortedTasks = groupedTasks[col].sort((a, b) => (priorityOrder[b.priority] || 0) - (priorityOrder[a.priority] || 0));
        const colTitle = col.replace(/[-_]/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
        return (
          <section key={col} style="background: rgba(255, 255, 255, 0.8); backdrop-filter: blur(10px); border-radius: 1rem; padding: 1.5rem; border: 1px solid rgba(0,0,0,0.1); min-height: 400px;" aria-labelledby={`col-${col}`} role="region">
            <h2 id={`col-${col}`} style="font-size: 1.5rem; font-weight: 600; margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 1px solid rgba(0,0,0,0.1);">
              {colTitle}
              <span style="font-size: 1rem; opacity: 0.7; font-weight: normal;">({sortedTasks.length})</span>
            </h2>
            {sortedTasks.length === 0 ? (
              <p style="color: #6b7280; font-style: italic;">No tasks</p>
            ) : (
              <ul style="list-style: none; padding: 0; margin: 0;">
                {sortedTasks.map((task) => (
                  <li key={task.id} style="margin-bottom: 1rem;">
                    <article id={task.id} style={`padding: 1rem; border-radius: 0.75rem; background: rgba(59,130,246,0.05); border-left: 4px solid ${priorityColors[task.priority]?.accent || '#3b82f6'};`}>
                      <h3 style="font-weight: bold; font-size: 1.1rem; margin-bottom: 0.5rem;">
                        <a href={'#' + task.id} style="color: inherit; text-decoration: none;">{task.title}</a>
                      </h3>
                      <p style="margin-bottom: 0.75rem; font-size: 0.9rem; color: #374151;">{task.description}</p>
                      <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                        {task.assignee && (
                          <span style="padding: 0.25rem 0.5rem; background: #dbeafe; color: #1e40af; font-size: 0.75rem; font-weight: 500; border-radius: 9999px;">@{task.assignee}</span>
                        )}
                        {task.priority && (
                          <span style={`padding: 0.25rem 0.5rem; background: ${priorityColors[task.priority].bg}; color: ${priorityColors[task.priority].text}; font-size: 0.75rem; font-weight: 500; border-radius: 9999px;`}>
                            {task.priority}
                          </span>
                        )}
                      </div>
                      {task.dueDate && (
                        <div style="margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px solid rgba(0,0,0,0.1); display: flex; align-items: center; gap: 0.5rem;">
                          <span style="font-size: 0.85rem; color: #6b7280;">Due: {task.dueDate.slice(0,10)}</span>
                          {new Date(task.dueDate) < new Date() && (
                            <span style="padding: 0.25rem 0.5rem; background: #fee2e2; color: #dc2626; font-size: 0.75rem; font-weight: 500; border-radius: 9999px;">Overdue</span>
                          )}
                        </div>
                      )}
                    </article>
                  </li>
                ))}
              </ul>
            )}
          </section>
        );
      })}
    </div>
  </main>
</BaseLayout>